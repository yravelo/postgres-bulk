<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.yravelo</groupId>
    <artifactId>postgres-bulk-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>postgres-bulk-spring-boot-starter-data-jdbc</artifactId>
  <name>PostgreSQL Bulk Spring Boot Starter for Spring Data JDBC</name>
  <description>Dependency-only starter for PostgreSQL Bulk with Spring Data JDBC</description>

  <properties>
    <spotbugs.skip>true</spotbugs.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>postgres-bulk-spring-boot-autoconfigure-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <additionalClasspathDependencies>
            <additionalClasspathDependency>
              <groupId>${project.groupId}</groupId>
              <artifactId>postgres-bulk-spring-boot-starter</artifactId>
              <version>${project.version}</version>
            </additionalClasspathDependency>
          </additionalClasspathDependencies>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-jdbc-starter-dependency-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.hibernate*:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>org.springframework.data:spring-data-jpa</exclude>
                    <exclude>io.github.yravelo:postgres-bulk-spring-data</exclude>
                    <exclude>io.github.yravelo:postgres-bulk-spring-boot-autoconfigure</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-actuator</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                  <message>The JDBC starter must remain free of JPA, Hibernate, and mandatory Actuator dependencies.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-code-free-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>sources</classifier>
                  <classesDirectory>${project.basedir}/src/release/sources</classesDirectory>
                </configuration>
              </execution>
              <execution>
                <id>attach-code-free-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${project.basedir}/src/release/javadocs</classesDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
