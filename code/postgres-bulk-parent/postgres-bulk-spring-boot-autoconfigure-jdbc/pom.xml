<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.yravelo</groupId>
    <artifactId>postgres-bulk-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>postgres-bulk-spring-boot-autoconfigure-jdbc</artifactId>
  <name>PostgreSQL Bulk Spring Boot JDBC Auto-configuration</name>
  <description>Spring Boot auto-configuration for PostgreSQL Bulk with Spring Data JDBC</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>postgres-bulk-spring-data-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-autoconfigure-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-jdbc-autoconfigure-dependency-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.hibernate*:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>org.springframework.data:spring-data-jpa</exclude>
                    <exclude>io.github.yravelo:postgres-bulk-spring-data</exclude>
                    <exclude>io.github.yravelo:postgres-bulk-spring-boot-autoconfigure</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                  <message>The JDBC auto-configuration must not acquire JPA or Hibernate production dependencies.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
